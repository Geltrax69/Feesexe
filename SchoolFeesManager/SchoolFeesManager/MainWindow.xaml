<Window x:Class="SchoolFeesManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:SchoolFeesManager"
        mc:Ignorable="d"
        Title="School Fees Manager" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal" 
        TextOptions.TextRenderingMode="Auto"        
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryHueMidBrush}" CornerRadius="0,20,20,0">
            <StackPanel Margin="10">
                <!-- App Title -->
                <TextBlock Text="EduFees Manager" Foreground="White" FontSize="20" FontWeight="Bold" Margin="20,20,20,40" HorizontalAlignment="Center"/>

                <!-- Navigation Menu -->
                <StackPanel>
                    <RadioButton Style="{StaticResource MaterialDesignTabRadioButton}" Margin="4" IsChecked="True" Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewDashboard" Margin="0,0,10,0"/>
                            <TextBlock Text="Dashboard"/>
                        </StackPanel>
                    </RadioButton>
                    
                    <RadioButton Style="{StaticResource MaterialDesignTabRadioButton}" Margin="4" Command="{Binding NavigateCommand}" CommandParameter="Students">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountSchool" Margin="0,0,10,0"/>
                            <TextBlock Text="Students"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource MaterialDesignTabRadioButton}" Margin="4" Command="{Binding NavigateCommand}" CommandParameter="Fees">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CurrencyUsd" Margin="0,0,10,0"/>
                            <TextBlock Text="Fees"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource MaterialDesignTabRadioButton}" Margin="4" Command="{Binding NavigateCommand}" CommandParameter="Ledger">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="BookOpenIsVariant" Margin="0,0,10,0"/>
                            <TextBlock Text="Ledger"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource MaterialDesignTabRadioButton}" Margin="4" Command="{Binding NavigateCommand}" CommandParameter="Reports">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileChart" Margin="0,0,10,0"/>
                            <TextBlock Text="Reports"/>
                        </StackPanel>
                    </RadioButton>
                    
                     <RadioButton Style="{StaticResource MaterialDesignTabRadioButton}" Margin="4" Command="{Binding NavigateCommand}" CommandParameter="Settings">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cog" Margin="0,0,10,0"/>
                            <TextBlock Text="Settings"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Grid Grid.Row="0" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="School Name: " FontWeight="Bold" Foreground="Gray"/>
                    <TextBlock Text="Sunrise International School" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ComboBox Width="120" materialDesign:HintAssist.Hint="Academic Year" Margin="0,0,20,0">
                        <ComboBoxItem IsSelected="True">2026-27</ComboBoxItem>
                        <ComboBoxItem>2027-28</ComboBoxItem>
                    </ComboBox>
                    
                    <materialDesign:PackIcon Kind="AccountCircle" Width="32" Height="32" VerticalAlignment="Center" Foreground="{StaticResource PrimaryHueMidBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Content -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="20"/>
        </Grid>
    </Grid>
</Window>
