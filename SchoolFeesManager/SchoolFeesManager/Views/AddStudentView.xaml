<UserControl x:Class="SchoolFeesManager.Views.AddStudentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:SchoolFeesManager.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.DataContext>
        <viewmodels:AddStudentViewModel/>
    </UserControl.DataContext>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Stepper Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30">
            <materialDesign:PackIcon Kind="Numeric1Circle" Width="30" Height="30" Foreground="{Binding CurrentStep, Converter={StaticResource StepColorConverter}, ConverterParameter=0}"/>
            <Border Width="50" Height="2" Background="Gray" VerticalAlignment="Center" Margin="10,0"/>
            <materialDesign:PackIcon Kind="Numeric2Circle" Width="30" Height="30" Foreground="{Binding CurrentStep, Converter={StaticResource StepColorConverter}, ConverterParameter=1}"/>
            <Border Width="50" Height="2" Background="Gray" VerticalAlignment="Center" Margin="10,0"/>
            <materialDesign:PackIcon Kind="Numeric3Circle" Width="30" Height="30" Foreground="{Binding CurrentStep, Converter={StaticResource StepColorConverter}, ConverterParameter=2}"/>
            <Border Width="50" Height="2" Background="Gray" VerticalAlignment="Center" Margin="10,0"/>
            <materialDesign:PackIcon Kind="Numeric4Circle" Width="30" Height="30" Foreground="{Binding CurrentStep, Converter={StaticResource StepColorConverter}, ConverterParameter=3}"/>
        </StackPanel>

        <!-- Form Content (Using Transitioner for slides) -->
        <materialDesign:Transitioner Grid.Row="1" SelectedIndex="{Binding CurrentStep}" AutoApplyTransitionOrigins="True">
            
            <!-- Step 1: Personal Info -->
            <materialDesign:TransitionerSlide>
                <StackPanel MaxWidth="600">
                    <TextBlock Text="Personal Information" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="First Name *" Text="{Binding NewStudent.FirstName}" Margin="0,0,10,20" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        <TextBox Grid.Column="1" materialDesign:HintAssist.Hint="Last Name" Text="{Binding NewStudent.LastName}" Margin="10,0,0,20" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    </Grid>
                    
                    <DatePicker materialDesign:HintAssist.Hint="Date of Birth" SelectedDate="{Binding NewStudent.DateOfBirth}" Margin="0,0,0,20" Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                    
                    <ComboBox materialDesign:HintAssist.Hint="Gender *" Text="{Binding NewStudent.Gender}" Margin="0,0,0,20" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                        <ComboBoxItem>Male</ComboBoxItem>
                        <ComboBoxItem>Female</ComboBoxItem>
                        <ComboBoxItem>Other</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </materialDesign:TransitionerSlide>

            <!-- Step 2: Academic Info -->
            <materialDesign:TransitionerSlide>
                <StackPanel MaxWidth="600">
                    <TextBlock Text="Academic Information" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                    <TextBox materialDesign:HintAssist.Hint="Student Key (Auto)" Text="{Binding NewStudent.StudentKey}" IsReadOnly="True" Margin="0,0,0,20" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" materialDesign:HintAssist.Hint="Class *" Text="{Binding NewStudent.ClassName}" Margin="0,0,10,20" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                            <ComboBoxItem>X</ComboBoxItem>
                            <ComboBoxItem>IX</ComboBoxItem>
                        </ComboBox>
                        <ComboBox Grid.Column="1" materialDesign:HintAssist.Hint="Section *" Text="{Binding NewStudent.Section}" Margin="10,0,0,20" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                            <ComboBoxItem>A</ComboBoxItem>
                            <ComboBoxItem>B</ComboBoxItem>
                        </ComboBox>
                    </Grid>
                    
                    <TextBox materialDesign:HintAssist.Hint="Academic Year" Text="{Binding NewStudent.AcademicYear}" Margin="0,0,0,20" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                </StackPanel>
            </materialDesign:TransitionerSlide>

            <!-- Step 3: Contact Info -->
            <materialDesign:TransitionerSlide>
                <StackPanel MaxWidth="600">
                    <TextBlock Text="Contact Information" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                    <TextBox materialDesign:HintAssist.Hint="Phone Number (+91)" Text="{Binding NewStudent.PhoneNumber}" Margin="0,0,0,20" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    <TextBox materialDesign:HintAssist.Hint="Address" Text="{Binding NewStudent.Address}" Margin="0,0,0,20" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="100" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </materialDesign:TransitionerSlide>

            <!-- Step 4: Parent Info -->
            <materialDesign:TransitionerSlide>
                <StackPanel MaxWidth="600">
                    <TextBlock Text="Parent / Guardian Information" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                    <TextBox materialDesign:HintAssist.Hint="Parent Name *" Text="{Binding NewStudent.ParentName}" Margin="0,0,0,20" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    <TextBox materialDesign:HintAssist.Hint="Parent Phone *" Text="{Binding NewStudent.ParentPhone}" Margin="0,0,0,20" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                </StackPanel>
            </materialDesign:TransitionerSlide>

        </materialDesign:Transitioner>

        <!-- Navigation Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding PreviousStepCommand}" Content="Back" Margin="0,0,10,0" IsEnabled="{Binding CurrentStep, Converter={StaticResource NotZeroConverter}}"/>
            
            <Button Style="{StaticResource MaterialDesignRaisedButton}" Command="{Binding NextStepCommand}" Content="Next" Visibility="{Binding CurrentStep, Converter={StaticResource NotLastStepConverter}}"/>
            <Button Style="{StaticResource MaterialDesignRaisedButton}" Command="{Binding SaveStudentCommand}" Content="Save Student" Visibility="{Binding CurrentStep, Converter={StaticResource LastStepConverter}}"/>
        </StackPanel>
    </Grid>
</UserControl>
